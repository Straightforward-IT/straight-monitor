{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://straightmonitor.local/payroll/schema/customer-site-payroll-declaration.v1.schema.json",
  "title": "StraightMonitor customer and site payroll declaration v1",
  "description": "Signed, effective-dated replacement for the AÜRV annex 'Zuschläge und Branchenzugehörigkeit'. Operational sector and an applicable Branchenzuschlag agreement are deliberately independent facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "declarationType",
    "declarationId",
    "revision",
    "status",
    "changeReason",
    "validityPeriod",
    "customer",
    "site",
    "industrySurchargeAgreement",
    "customerPremiumRules",
    "equalPayComparator",
    "holidayCalendar",
    "timeEvidenceRequirements",
    "billingMinimumSeparation",
    "evidencePackage",
    "changeHistory"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "declarationType": {
      "const": "CUSTOMER_SITE_PAYROLL_DECLARATION"
    },
    "declarationId": {
      "$ref": "#/$defs/stableId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedesDeclarationId": {
      "oneOf": [
        { "$ref": "#/$defs/stableId" },
        { "type": "null" }
      ],
      "default": null
    },
    "status": {
      "enum": ["DRAFT", "CUSTOMER_SIGNED", "REVIEWED", "SUPERSEDED", "CANCELLED"]
    },
    "changeReason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "validityPeriod": {
      "$ref": "#/$defs/openDateRange"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internalCustomerId", "customerNumberSnapshot", "legalName"],
      "properties": {
        "internalCustomerId": { "$ref": "#/$defs/stableId" },
        "customerNumberSnapshot": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1, "maxLength": 64 }
          ]
        },
        "legalName": { "type": "string", "minLength": 2, "maxLength": 300 },
        "registrationIdentifier": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteKey",
        "siteName",
        "address",
        "timeZone",
        "operationalSector",
        "operationalSectorDescription",
        "holidayJurisdiction"
      ],
      "properties": {
        "siteKey": { "$ref": "#/$defs/stableId" },
        "siteName": { "type": "string", "minLength": 2, "maxLength": 300 },
        "address": { "$ref": "#/$defs/postalAddress" },
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+$",
          "default": "Europe/Berlin"
        },
        "operationalSector": {
          "description": "Operational business classification only. It never selects a Branchenzuschlag agreement by itself.",
          "enum": [
            "GASTRONOMY",
            "HOSPITALITY",
            "EVENTS",
            "CATERING",
            "EVENT_CATERING",
            "OTHER_VERIFIED"
          ]
        },
        "operationalSectorDescription": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "holidayJurisdiction": { "$ref": "#/$defs/federalState" }
      }
    },
    "industrySurchargeAgreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "agreementCode", "assessment"],
      "properties": {
        "decision": {
          "description": "UNKNOWN blocks activation and payroll export. NONE is an evidenced conclusion, not a consequence of operationalSector.",
          "enum": ["UNKNOWN", "NONE", "APPLICABLE"]
        },
        "agreementCode": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "agreementTitle": { "type": ["string", "null"], "maxLength": 500 },
        "ruleVersionRef": { "type": ["string", "null"], "maxLength": 200 },
        "sourceAgreement": {
          "oneOf": [
            { "$ref": "#/$defs/sourceAgreement" },
            { "type": "null" }
          ]
        },
        "assessment": { "$ref": "#/$defs/assessment" },
        "unknownReason": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "UNKNOWN" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "agreementCode": { "type": "null" },
              "unknownReason": { "type": "string", "minLength": 3 }
            },
            "required": ["unknownReason"]
          }
        },
        {
          "if": { "properties": { "decision": { "const": "NONE" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "agreementCode": { "const": "NONE" },
              "unknownReason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "APPLICABLE" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "agreementCode": {
                "type": "string",
                "minLength": 2,
                "not": { "enum": ["NONE", "UNKNOWN"] }
              },
              "agreementTitle": { "type": "string", "minLength": 3 },
              "ruleVersionRef": { "type": "string", "minLength": 2 },
              "sourceAgreement": { "$ref": "#/$defs/sourceAgreement" },
              "unknownReason": { "type": "null" }
            },
            "required": ["agreementTitle", "ruleVersionRef", "sourceAgreement"]
          }
        }
      ]
    },
    "customerPremiumRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "nightBasisPoints",
        "sundayBasisPoints",
        "holidayBasisPoints",
        "nightWindow",
        "overlapPolicy",
        "assessment"
      ],
      "properties": {
        "decision": { "enum": ["UNKNOWN", "NONE", "CUSTOMER_RULES"] },
        "nightBasisPoints": { "$ref": "#/$defs/basisPoints" },
        "sundayBasisPoints": { "$ref": "#/$defs/basisPoints" },
        "holidayBasisPoints": { "$ref": "#/$defs/basisPoints" },
        "nightWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/time" },
            "end": { "$ref": "#/$defs/time" }
          }
        },
        "overlapPolicy": { "enum": ["HIGHEST_ONLY", "STACK"] },
        "sourceAgreement": {
          "oneOf": [
            { "$ref": "#/$defs/sourceAgreement" },
            { "type": "null" }
          ]
        },
        "assessment": {
          "allOf": [
            { "$ref": "#/$defs/assessment" },
            {
              "type": "object",
              "required": [
                "customerAgreementsChecked",
                "companyRulesChecked",
                "employeeRulesChecked",
                "historicalPayrollChecked",
                "noMoreFavorableRuleFound",
                "noContradictoryHistoricalPayroll"
              ],
              "properties": {
                "customerAgreementsChecked": { "type": "boolean" },
                "companyRulesChecked": { "type": "boolean" },
                "employeeRulesChecked": { "type": "boolean" },
                "historicalPayrollChecked": { "type": "boolean" },
                "noMoreFavorableRuleFound": { "type": "boolean" },
                "noContradictoryHistoricalPayroll": { "type": "boolean" }
              }
            }
          ]
        },
        "unknownReason": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "UNKNOWN" } }, "required": ["decision"] },
          "then": {
            "properties": { "unknownReason": { "type": "string", "minLength": 3 } },
            "required": ["unknownReason"]
          }
        },
        {
          "if": { "properties": { "decision": { "const": "NONE" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "nightBasisPoints": { "const": 0 },
              "sundayBasisPoints": { "const": 0 },
              "holidayBasisPoints": { "const": 0 },
              "sourceAgreement": { "$ref": "#/$defs/sourceAgreement" },
              "unknownReason": { "type": "null" },
              "assessment": {
                "properties": {
                  "customerAgreementsChecked": { "const": true },
                  "companyRulesChecked": { "const": true },
                  "employeeRulesChecked": { "const": true },
                  "historicalPayrollChecked": { "const": true },
                  "noMoreFavorableRuleFound": { "const": true },
                  "noContradictoryHistoricalPayroll": { "const": true }
                }
              }
            },
            "required": ["sourceAgreement"]
          }
        },
        {
          "if": { "properties": { "decision": { "const": "CUSTOMER_RULES" } }, "required": ["decision"] },
          "then": {
            "properties": {
              "sourceAgreement": { "$ref": "#/$defs/sourceAgreement" },
              "unknownReason": { "type": "null" }
            },
            "required": ["sourceAgreement"]
          }
        }
      ]
    },
    "equalPayComparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "comparisonGroup",
        "comparisonHourlyRateCents",
        "comparisonMonthlyAmountCents",
        "regularComponents",
        "source",
        "evidenceRefs",
        "evidenceHash",
        "validityPeriod"
      ],
      "properties": {
        "status": { "enum": ["PENDING", "VERIFIED", "EXPIRED", "NOT_APPLICABLE"] },
        "comparisonGroup": { "type": ["string", "null"], "maxLength": 500 },
        "comparisonHourlyRateCents": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "comparisonMonthlyAmountCents": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "comparisonHourlyRateScope": {
          "description": "Whether comparisonHourlyRateCents is base pay only or an evidenced all-in conversion of the complete regular package. Missing values must be treated as BASE_ONLY by importers.",
          "enum": ["BASE_ONLY", "ALL_IN_REGULAR_PACKAGE"],
          "default": "BASE_ONLY"
        },
        "conversionPolicyId": { "type": ["string", "null"], "maxLength": 200 },
        "conversionEvidenceHash": {
          "oneOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "regularComponents": {
          "type": "array",
          "items": { "$ref": "#/$defs/comparisonComponent" }
        },
        "source": { "type": ["string", "null"], "maxLength": 1000 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "evidenceHash": {
          "oneOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        },
        "declarationSignature": {
          "oneOf": [
            { "$ref": "#/$defs/signature" },
            { "type": "null" }
          ]
        },
        "validityPeriod": {
          "oneOf": [
            { "$ref": "#/$defs/openDateRange" },
            { "type": "null" }
          ]
        },
        "notApplicableReason": { "type": ["string", "null"], "maxLength": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "VERIFIED" } }, "required": ["status"] },
          "then": {
            "properties": {
              "comparisonGroup": { "type": "string", "minLength": 2 },
              "comparisonHourlyRateCents": { "type": "integer", "minimum": 0 },
              "source": { "type": "string", "minLength": 2 },
              "evidenceRefs": { "$ref": "#/$defs/nonEmptyEvidenceRefs" },
              "evidenceHash": { "$ref": "#/$defs/hash" },
              "declarationSignature": { "$ref": "#/$defs/signature" },
              "validityPeriod": { "$ref": "#/$defs/openDateRange" }
            },
            "required": ["declarationSignature"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } }, "required": ["status"] },
          "then": {
            "properties": { "notApplicableReason": { "type": "string", "minLength": 3 } },
            "required": ["notApplicableReason"]
          }
        },
        {
          "if": {
            "properties": { "comparisonHourlyRateScope": { "const": "ALL_IN_REGULAR_PACKAGE" } },
            "required": ["comparisonHourlyRateScope"]
          },
          "then": {
            "properties": {
              "conversionPolicyId": { "type": "string", "minLength": 2 },
              "conversionEvidenceHash": { "$ref": "#/$defs/hash" }
            },
            "required": ["conversionPolicyId", "conversionEvidenceHash"]
          }
        }
      ]
    },
    "holidayCalendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendarId", "federalState", "dates", "source", "sourceVersion", "evidenceHash"],
      "properties": {
        "calendarId": { "$ref": "#/$defs/stableId" },
        "federalState": { "$ref": "#/$defs/federalState" },
        "dates": {
          "type": "array",
          "items": { "$ref": "#/$defs/date" },
          "uniqueItems": true
        },
        "source": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidenceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "timeEvidenceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electronicDeliveryRequired",
        "actualStartRequired",
        "actualEndRequired",
        "detailedBreaksRequired",
        "timeZoneRequired",
        "siteRequired",
        "crossMidnightAllocationRequired",
        "approverIdentityRequired",
        "approvalTimestampRequired",
        "correctionHistoryRequired",
        "deliveryChannel"
      ],
      "properties": {
        "electronicDeliveryRequired": { "const": true },
        "actualStartRequired": { "const": true },
        "actualEndRequired": { "const": true },
        "detailedBreaksRequired": { "const": true },
        "timeZoneRequired": { "const": true },
        "siteRequired": { "const": true },
        "crossMidnightAllocationRequired": { "const": true },
        "approverIdentityRequired": { "const": true },
        "approvalTimestampRequired": { "const": true },
        "correctionHistoryRequired": { "const": true },
        "deliveryChannel": { "enum": ["STRAIGHTMONITOR_API", "STRAIGHTMONITOR_PORTAL", "SFTP", "OTHER_SECURE_ELECTRONIC"] },
        "deliveryDeadline": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "billingMinimumSeparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworkClause",
        "commercialInvoiceMinimumAcknowledged",
        "createsPaidHours",
        "createsAZKMovement"
      ],
      "properties": {
        "frameworkClause": { "const": "AÜRV_2026 § 6.4" },
        "commercialInvoiceMinimumAcknowledged": { "const": true },
        "createsPaidHours": { "const": false },
        "createsAZKMovement": { "const": false },
        "note": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "evidencePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceContractRef",
        "sourceContractHash",
        "evidenceRefs",
        "evidenceManifestHash",
        "customerSignature",
        "signedPayloadHash",
        "signedDocumentHash"
      ],
      "properties": {
        "sourceContractRef": { "const": "Documentation/Payroll/AÜRV_2026.md" },
        "sourceContractHash": { "$ref": "#/$defs/hash" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyEvidenceRefs" },
        "evidenceManifestHash": { "$ref": "#/$defs/hash" },
        "customerSignature": { "$ref": "#/$defs/signature" },
        "providerAcknowledgementSignature": {
          "oneOf": [
            { "$ref": "#/$defs/signature" },
            { "type": "null" }
          ]
        },
        "signedPayloadHash": { "$ref": "#/$defs/hash" },
        "signedDocumentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "internalReview": {
      "oneOf": [
        { "$ref": "#/$defs/internalReview" },
        { "type": "null" }
      ],
      "default": null
    },
    "changeHistory": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeEntry" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "minimum": 2 } }, "required": ["revision"] },
      "then": {
        "properties": { "supersedesDeclarationId": { "$ref": "#/$defs/stableId" } },
        "required": ["supersedesDeclarationId"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "REVIEWED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "industrySurchargeAgreement": {
            "properties": {
              "decision": { "enum": ["NONE", "APPLICABLE"] }
            }
          },
          "customerPremiumRules": {
            "properties": {
              "decision": { "enum": ["NONE", "CUSTOMER_RULES"] }
            }
          },
          "equalPayComparator": {
            "properties": {
              "status": { "const": "VERIFIED" }
            }
          },
          "internalReview": { "$ref": "#/$defs/internalReview" }
        },
        "required": ["internalReview"]
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "hash": {
      "type": "string",
      "pattern": "^(?:sha256:)?[A-Fa-f0-9]{64}$"
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "federalState": {
      "enum": ["BW", "BY", "BE", "BB", "HB", "HH", "HE", "MV", "NI", "NW", "RP", "SL", "SN", "ST", "SH", "TH"]
    },
    "openDateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validFrom", "validTill"],
      "properties": {
        "validFrom": { "$ref": "#/$defs/date" },
        "validTill": {
          "oneOf": [
            { "$ref": "#/$defs/date" },
            { "type": "null" }
          ]
        }
      }
    },
    "postalAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "houseNumber", "postalCode", "city", "federalState", "countryCode"],
      "properties": {
        "street": { "type": "string", "minLength": 1, "maxLength": 200 },
        "houseNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "postalCode": { "type": "string", "pattern": "^[0-9]{5}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 200 },
        "federalState": { "$ref": "#/$defs/federalState" },
        "countryCode": { "const": "DE" }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 2, "maxLength": 500 },
      "uniqueItems": true
    },
    "nonEmptyEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2, "maxLength": 500 },
      "uniqueItems": true
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["assessedBy", "assessedAt", "sourcesChecked", "evidenceRefs", "evidenceHash"],
      "properties": {
        "assessedBy": { "$ref": "#/$defs/stableId" },
        "assessedAt": { "$ref": "#/$defs/dateTime" },
        "sourcesChecked": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2, "maxLength": 500 },
          "uniqueItems": true
        },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyEvidenceRefs" },
        "evidenceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceAgreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "identifier", "version", "validityPeriod", "evidenceRefs", "documentHash"],
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 500 },
        "identifier": { "type": "string", "minLength": 2, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "validityPeriod": { "$ref": "#/$defs/openDateRange" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyEvidenceRefs" },
        "documentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signerName",
        "signerRole",
        "organization",
        "signedAt",
        "signatureMethod",
        "signatureEnvelopeId",
        "signatureHash"
      ],
      "properties": {
        "signerName": { "type": "string", "minLength": 2, "maxLength": 300 },
        "signerRole": { "type": "string", "minLength": 2, "maxLength": 300 },
        "organization": { "type": "string", "minLength": 2, "maxLength": 300 },
        "signedAt": { "$ref": "#/$defs/dateTime" },
        "signatureMethod": { "enum": ["QUALIFIED_ELECTRONIC", "ADVANCED_ELECTRONIC", "DOCUSEAL_ENVELOPE", "WET_INK_SCAN", "OTHER_VERIFIABLE"] },
        "signatureEnvelopeId": { "type": "string", "minLength": 2, "maxLength": 300 },
        "signatureHash": { "$ref": "#/$defs/hash" }
      }
    },
    "comparisonComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "amountCents", "frequency"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$" },
        "amountCents": { "type": "integer" },
        "frequency": { "enum": ["HOURLY", "DAILY", "WEEKLY", "MONTHLY", "ANNUAL", "ONE_TIME"] }
      }
    },
    "internalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparedBy", "preparedAt", "reviewedBy", "reviewedAt", "reviewReason", "fourEyesConfirmed"],
      "properties": {
        "preparedBy": { "$ref": "#/$defs/stableId" },
        "preparedAt": { "$ref": "#/$defs/dateTime" },
        "reviewedBy": { "$ref": "#/$defs/stableId" },
        "reviewedAt": { "$ref": "#/$defs/dateTime" },
        "reviewReason": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "fourEyesConfirmed": { "const": true },
        "reviewEvidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "changeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "changedAt", "changedBy", "reason", "contentHash"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "changedAt": { "$ref": "#/$defs/dateTime" },
        "changedBy": { "$ref": "#/$defs/stableId" },
        "reason": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "contentHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
